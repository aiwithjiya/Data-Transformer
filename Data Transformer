-- =====================================================
-- QUERY 1: INNER JOIN
-- Retrieve all orders and customer details where orders exist
-- =====================================================

SELECT o.OrderID, o.CustomerID,
       c.FirstName, c.LastName, c.Email,
       o.OrderDate, o.TotalAmount
FROM Orders o
INNER JOIN Customers c
ON o.CustomerID = c.CustomerID;


-- =====================================================
-- QUERY 2: LEFT JOIN
-- Retrieve all customers and their corresponding orders
-- =====================================================

SELECT c.CustomerID, c.FirstName, c.LastName,
       o.OrderID, o.OrderDate, o.TotalAmount
FROM Customers c
LEFT JOIN Orders o
ON c.CustomerID = o.CustomerID;


-- =====================================================
-- QUERY 3: RIGHT JOIN
-- Retrieve all orders and their corresponding customers
-- =====================================================

SELECT o.OrderID, o.CustomerID,
       o.OrderDate, o.TotalAmount,
       c.FirstName, c.LastName
FROM Customers c
RIGHT JOIN Orders o
ON c.CustomerID = o.CustomerID;


-- =====================================================
-- QUERY 4: FULL OUTER JOIN
-- Retrieve all customers and all orders
-- =====================================================

SELECT c.CustomerID, c.FirstName, c.LastName,
       o.OrderID, o.OrderDate, o.TotalAmount
FROM Customers c
LEFT JOIN Orders o
ON c.CustomerID = o.CustomerID

UNION

SELECT c.CustomerID, c.FirstName, c.LastName,
       o.OrderID, o.OrderDate, o.TotalAmount
FROM Customers c
RIGHT JOIN Orders o
ON c.CustomerID = o.CustomerID;


-- =====================================================
-- QUERY 5: SUBQUERY
-- Find customers who placed orders above average amount
-- =====================================================

SELECT c.CustomerID, c.FirstName, c.LastName,
       o.TotalAmount
FROM Customers c
INNER JOIN Orders o
ON c.CustomerID = o.CustomerID
WHERE o.TotalAmount > (
    SELECT AVG(TotalAmount)
    FROM Orders
);


-- =====================================================
-- QUERY 6: SUBQUERY
-- Find employees with salaries above average salary
-- =====================================================

SELECT EmployeeID, FirstName, LastName,
       Department, Salary
FROM Employees
WHERE Salary > (
    SELECT AVG(Salary)
    FROM Employees
);


-- =====================================================
-- QUERY 7: EXTRACT YEAR AND MONTH
-- Extract year and month from OrderDate
-- =====================================================

SELECT OrderID, OrderDate,
       YEAR(OrderDate) AS OrderYear,
       MONTH(OrderDate) AS OrderMonth
FROM Orders;


-- =====================================================
-- QUERY 8: DATE DIFFERENCE
-- Calculate difference in days between OrderDate and current date
-- =====================================================

SELECT OrderID, OrderDate,
       DATEDIFF(CURDATE(), OrderDate) AS DaysDifference
FROM Orders;


-- =====================================================
-- QUERY 9: FORMAT DATE
-- Format OrderDate as DD-MMM-YYYY
-- =====================================================

SELECT OrderID, OrderDate,
       DATE_FORMAT(OrderDate, '%d-%b-%Y') AS FormattedDate
FROM Orders;


-- =====================================================
-- QUERY 10: CONCATENATE NAME
-- Concatenate FirstName and LastName to form full name
-- =====================================================

SELECT CustomerID,
       CONCAT(FirstName, ' ', LastName) AS FullName
FROM Customers;


-- =====================================================
-- QUERY 11: REPLACE STRING
-- Replace 'John' with 'Jonathan'
-- =====================================================

SELECT CustomerID,
       REPLACE(FirstName, 'John', 'Jonathan') AS UpdatedFirstName
FROM Customers;


-- =====================================================
-- QUERY 12: UPPERCASE AND LOWERCASE
-- Convert FirstName to uppercase and LastName to lowercase
-- =====================================================

SELECT CustomerID,
       UPPER(FirstName) AS UpperFirstName,
       LOWER(LastName) AS LowerLastName
FROM Customers;


-- =====================================================
-- QUERY 13: TRIM EMAIL
-- Trim extra spaces from Email field
-- =====================================================

SELECT CustomerID,
       TRIM(Email) AS TrimmedEmail
FROM Customers;


-- =====================================================
-- QUERY 14: RUNNING TOTAL
-- Calculate running total of TotalAmount for each order
-- =====================================================

SELECT OrderID, OrderDate, TotalAmount,
       SUM(TotalAmount) OVER (
           ORDER BY OrderDate
       ) AS RunningTotal
FROM Orders;


-- =====================================================
-- QUERY 15: RANK
-- Rank orders based on TotalAmount
-- =====================================================

SELECT OrderID, TotalAmount,
       RANK() OVER (
           ORDER BY TotalAmount DESC
       ) AS OrderRank
FROM Orders;


-- =====================================================
-- QUERY 16: DISCOUNT USING CASE
-- Assign discount based on TotalAmount
-- =====================================================

SELECT OrderID, TotalAmount,
       CASE
           WHEN TotalAmount > 1000 THEN '10% OFF'
           WHEN TotalAmount > 500 THEN '5% OFF'
           ELSE 'No Discount'
       END AS Discount
FROM Orders;


-- =====================================================
-- QUERY 17: SALARY CATEGORY
-- Categorize employees as High, Medium, or Low
-- =====================================================

SELECT EmployeeID, FirstName, LastName,
       Salary,
       CASE
           WHEN Salary >= 65000 THEN 'High'
           WHEN Salary >= 50000 THEN 'Medium'
           ELSE 'Low'
       END AS SalaryCategory
FROM Employees;